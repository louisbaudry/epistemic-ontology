@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://louisbaudry.github.io/epistemic-ontology/vocab/> .

# Version 0.1, first draft. Generated from the approved specifications; the
# specification text is the authority. The namespace base is unconfirmed: these
# IRIs resolve only once GitHub Pages is enabled for the repository.

:excerpt-kinds a skos:ConceptScheme ;
    dcterms:title "Excerpt kinds"@en ;
    dcterms:source "SPEC-003 §7" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:hasVersion "0.1" ;
    skos:scopeNote "Three excerpt-like kinds stay distinct and are never silently converted into one another. A quotation is never created from a paraphrase or a summary."@en ;
    skos:hasTopConcept :excerpt-kinds-quotation, :excerpt-kinds-paraphrase, :excerpt-kinds-summary .

:excerpt-kinds-quotation a skos:Concept ;
    skos:inScheme :excerpt-kinds ;
    skos:topConceptOf :excerpt-kinds ;
    skos:notation "quotation" ;
    skos:prefLabel "quotation"@en ;
    skos:definition "The exact passage, verbatim, in the original language."@en .

:excerpt-kinds-paraphrase a skos:Concept ;
    skos:inScheme :excerpt-kinds ;
    skos:topConceptOf :excerpt-kinds ;
    skos:notation "paraphrase" ;
    skos:prefLabel "paraphrase"@en ;
    skos:definition "A restatement in the recorder's words, labelled as such."@en .

:excerpt-kinds-summary a skos:Concept ;
    skos:inScheme :excerpt-kinds ;
    skos:topConceptOf :excerpt-kinds ;
    skos:notation "summary" ;
    skos:prefLabel "summary"@en ;
    skos:definition "A condensed account of a larger passage, labelled as such."@en .
