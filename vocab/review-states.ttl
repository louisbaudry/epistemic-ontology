:review-states a skos:ConceptScheme ;
    dcterms:title "Review states"@en ;
    dcterms:source "SPEC-001 §10" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:hasVersion "0.1" ;
    skos:scopeNote "The review state carried by every assertion. Output from a language model or other automated process enters only as `draft`."@en ;
    skos:hasTopConcept :review-states-draft, :review-states-unreviewed, :review-states-reviewed .

:review-states-draft a skos:Concept ;
    skos:inScheme :review-states ;
    skos:topConceptOf :review-states ;
    skos:notation "draft" ;
    skos:prefLabel "draft"@en ;
    skos:definition "Proposed, not adopted; the starting state of anything a process proposed."@en .

:review-states-unreviewed a skos:Concept ;
    skos:inScheme :review-states ;
    skos:topConceptOf :review-states ;
    skos:notation "unreviewed" ;
    skos:prefLabel "unreviewed"@en ;
    skos:definition "Entered by the analyst, not yet checked by anyone else."@en .

:review-states-reviewed a skos:Concept ;
    skos:inScheme :review-states ;
    skos:topConceptOf :review-states ;
    skos:notation "reviewed" ;
    skos:prefLabel "reviewed"@en ;
    skos:scopeNote "The specification gives no definition text for this value."@en .
