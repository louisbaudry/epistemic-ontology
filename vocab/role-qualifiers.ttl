:role-qualifiers a skos:ConceptScheme ;
    dcterms:title "Role qualifiers"@en ;
    dcterms:source "SPEC-002 §6" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:hasVersion "0.1" ;
    skos:scopeNote "Optional qualifier of a role event. A role event may carry none. The specification gives no definition text for the values of this scheme; none is added here."@en ;
    skos:hasTopConcept :role-qualifiers-acting, :role-qualifiers-interim, :role-qualifiers-de-facto, :role-qualifiers-disputed .

:role-qualifiers-acting a skos:Concept ;
    skos:inScheme :role-qualifiers ;
    skos:topConceptOf :role-qualifiers ;
    skos:notation "acting" ;
    skos:prefLabel "acting"@en .

