:referent-statuses a skos:ConceptScheme ;
    dcterms:title "Referent statuses"@en ;
    dcterms:source "SPEC-002 §5" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:hasVersion "0.1" ;
    skos:scopeNote "Every referent carries one status. A new referent starts as `candidate`. `fabricated` and `disproved` referents are kept, never deleted."@en ;
    skos:hasTopConcept :referent-statuses-canonical, :referent-statuses-candidate, :referent-statuses-fabricated, :referent-statuses-disproved .

:referent-statuses-canonical a skos:Concept ;
    skos:inScheme :referent-statuses ;
    skos:topConceptOf :referent-statuses ;
    skos:notation "canonical" ;
    skos:prefLabel "canonical"@en ;
    skos:definition "Treated as a real, distinct referent."@en .

:referent-statuses-candidate a skos:Concept ;
    skos:inScheme :referent-statuses ;
    skos:topConceptOf :referent-statuses ;
    skos:notation "candidate" ;
    skos:prefLabel "candidate"@en ;
    skos:definition "Provisionally distinct, not yet consolidated. A lead enters here."@en .

:referent-statuses-fabricated a skos:Concept ;
    skos:inScheme :referent-statuses ;
    skos:topConceptOf :referent-statuses ;
    skos:notation "fabricated" ;
    skos:prefLabel "fabricated"@en ;
    skos:definition "Concluded never to have referred to a real, distinct referent: an invented persona or identity."@en .

:referent-statuses-disproved a skos:Concept ;
    skos:inScheme :referent-statuses ;
    skos:topConceptOf :referent-statuses ;
    skos:notation "disproved" ;
    skos:prefLabel "disproved"@en ;
    skos:definition "Shown to be a duplicate or an error, pointing to what replaced it."@en .
