    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:hasVersion "0.1" ;
    skos:scopeNote "The typed relations by which one source's dependence on another is recorded (upstream DR-0028). Corroboration counts independent origins, not documents. The specification gives no definition text for the values of this scheme; none is added here."@en ;
