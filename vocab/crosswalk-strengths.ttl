:crosswalk-strengths a skos:ConceptScheme ;
    dcterms:title "Crosswalk strengths"@en ;
    dcterms:source "SPEC-004 §2" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:hasVersion "0.1" ;
    skos:scopeNote "The rating of a row in a crosswalk between a core element and a term of an external standard."@en ;
    skos:hasTopConcept :crosswalk-strengths-exact, :crosswalk-strengths-partial, :crosswalk-strengths-none .

:crosswalk-strengths-exact a skos:Concept ;
    skos:inScheme :crosswalk-strengths ;
    skos:topConceptOf :crosswalk-strengths ;
    skos:notation "exact" ;
    skos:prefLabel "exact"@en ;
    skos:definition "Same meaning, nothing lost."@en .

:crosswalk-strengths-partial a skos:Concept ;
    skos:inScheme :crosswalk-strengths ;
    skos:topConceptOf :crosswalk-strengths ;
    skos:notation "partial" ;
    skos:prefLabel "partial"@en ;
    skos:definition "Same idea, something lost or added."@en .

:crosswalk-strengths-none a skos:Concept ;
    skos:inScheme :crosswalk-strengths ;
    skos:topConceptOf :crosswalk-strengths ;
    skos:notation "none" ;
    skos:prefLabel "none"@en ;
    skos:definition "No counterpart found in the terms read."@en .
