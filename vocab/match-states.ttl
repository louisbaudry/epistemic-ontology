:match-states a skos:ConceptScheme ;
    dcterms:title "Match states"@en ;
    dcterms:source "SPEC-002 §7" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:hasVersion "0.1" ;
    skos:scopeNote "The states of a match between two identity bearers (upstream DR-0063). A state change is a superseding assertion with an asserter and a basis. Automated matchers may create only `proposed` matches; confirmation is a human decision on discriminating evidence."@en ;
    skos:hasTopConcept :match-states-proposed, :match-states-under-review, :match-states-confirmed, :match-states-rejected, :match-states-withdrawn .

:match-states-proposed a skos:Concept ;
    skos:inScheme :match-states ;
    skos:topConceptOf :match-states ;
    skos:notation "proposed" ;
    skos:prefLabel "proposed"@en .

:match-states-under-review a skos:Concept ;
    skos:inScheme :match-states ;
    skos:topConceptOf :match-states ;
    skos:notation "under-review" ;
    skos:prefLabel "under-review"@en .

:match-states-confirmed a skos:Concept ;
    skos:inScheme :match-states ;
    skos:topConceptOf :match-states ;
    skos:notation "confirmed" ;
    skos:prefLabel "confirmed"@en .

:match-states-rejected a skos:Concept ;
    skos:inScheme :match-states ;
    skos:topConceptOf :match-states ;
    skos:notation "rejected" ;
    skos:prefLabel "rejected"@en .

:match-states-withdrawn a skos:Concept ;
    skos:inScheme :match-states ;
    skos:topConceptOf :match-states ;
    skos:notation "withdrawn" ;
    skos:prefLabel "withdrawn"@en ;
    skos:definition "A proposer's retraction."@en .
