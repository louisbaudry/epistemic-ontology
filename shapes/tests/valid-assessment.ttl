@prefix core: <https://louisbaudry.github.io/epistemic-ontology/core/> .
@prefix vocab: <https://louisbaudry.github.io/epistemic-ontology/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/> .

# Invented, neutral example data. Expected: conforms. Likelihood and confidence are separate and carry a rationale.
ex:a1 a core:Assertion ;
    core:kind vocab:assertion-kinds-assessment ;
    core:subject ex:bridge-1 ;
    core:content "The footbridge opened to pedestrians." ;
    core:asserted_at "2026-03-01T10:00:00Z"^^xsd:dateTime ;
    core:asserter ex:agent-a ;
    core:recorded_by ex:agent-b ;
    core:review vocab:review-states-unreviewed ;
    core:valid_time "2021"^^xsd:gYear ;
    core:basis "Reasoning in prose." ;
    core:assessment ex:j1 .

ex:j1 a core:Assessment ;
    core:likelihood vocab:likelihood-bands-likely ;
    core:analytic_confidence vocab:analytic-confidence-levels-moderate ;
    core:rationale "Two notices agree; neither is independent of the other." .
