@prefix core: <https://louisbaudry.github.io/epistemic-ontology/core/> .
@prefix vocab: <https://louisbaudry.github.io/epistemic-ontology/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/> .

# Invented, neutral example data. Expected: fails SPEC-001 5.4 (the named assumption is a claim).
ex:s1 a core:Assertion ;
    core:kind vocab:assertion-kinds-claim ;
    core:subject ex:bridge-1 ;
    core:content "The footbridge was not repaired between the two notices." ;
    core:asserted_at "2026-03-01T10:00:00Z"^^xsd:dateTime ;
    core:asserter ex:agent-a ;
    core:recorded_by ex:agent-a ;
    core:review vocab:review-states-unreviewed .

ex:a1 a core:Assertion ;
    core:kind vocab:assertion-kinds-assessment ;
    core:subject ex:bridge-1 ;
    core:content "The footbridge opened to pedestrians." ;
    core:asserted_at "2026-03-01T10:05:00Z"^^xsd:dateTime ;
    core:asserter ex:agent-a ;
    core:recorded_by ex:agent-a ;
    core:review vocab:review-states-unreviewed ;
    core:basis "Two notices agree; the second is read on the assumption stated above." ;
    core:assessment ex:j1 .

ex:j1 a core:Assessment ;
    core:likelihood vocab:likelihood-bands-likely ;
    core:rationale "The notices agree." ;
    core:indicators "A repair notice dated between the two would lower this." .

ex:d1 a core:Dependency ;
    core:dependent ex:a1 ;
    core:assumption ex:s1 ;
    core:if_wrong "Unsupported." ;
.
