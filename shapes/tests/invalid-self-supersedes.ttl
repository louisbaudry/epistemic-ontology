@prefix core: <https://louisbaudry.github.io/epistemic-ontology/core/> .
@prefix vocab: <https://louisbaudry.github.io/epistemic-ontology/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/> .

# Invented, neutral example data. Expected: fails SPEC-001 11.6 (an assertion supersedes itself).
ex:a1 a core:Assertion ;
    core:kind vocab:assertion-kinds-claim ;
    core:subject ex:bridge-1 ;
    core:content "The footbridge opened to pedestrians." ;
    core:asserted_at "2026-03-01T10:00:00Z"^^xsd:dateTime ;
    core:asserter ex:agent-a ;
    core:recorded_by ex:agent-b ;
    core:review vocab:review-states-unreviewed ;
    core:valid_time "2021"^^xsd:gYear ;
    core:supersedes ex:a1 .
