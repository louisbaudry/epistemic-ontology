@prefix core: <https://louisbaudry.github.io/epistemic-ontology/core/> .
@prefix vocab: <https://louisbaudry.github.io/epistemic-ontology/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/> .

# Invented, neutral example data. Expected: conforms. An automated contribution held as draft, with a process note.
ex:a1 a core:Assertion ;
    core:kind vocab:assertion-kinds-claim ;
    core:subject ex:bridge-1 ;
    core:content "The footbridge opened to pedestrians." ;
    core:asserted_at "2026-03-01T10:00:00Z"^^xsd:dateTime ;
    core:asserter ex:agent-a ;
    core:recorded_by ex:agent-b ;
    core:review vocab:review-states-draft ;
    core:valid_time "2021"^^xsd:gYear ;
    core:contributed_by ex:auto-1 .

ex:auto-1 a core:Automation ;
    core:process "extraction-pipeline" ;
    core:role "proposed the record" ;
    core:date "2026-03-01"^^xsd:date ;
    core:process_note "Version 2.1; prompt: extract the date of opening from the notice; default settings; the provider states a precision of 90 percent on its own test set, which is its claim and not a confidence in this record."@en .
