@prefix core: <https://louisbaudry.github.io/epistemic-ontology/core/> .
@prefix vocab: <https://louisbaudry.github.io/epistemic-ontology/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/> .

# Invented, neutral example data. Expected: fails SPEC-001 11.4 (a number on an assessment).

ex:j1 a core:Assessment ;
    core:likelihood vocab:likelihood-bands-likely ;
    core:analytic_confidence vocab:analytic-confidence-levels-high ;
    core:rationale "Reasoning." ;
    core:score 0.8 .
